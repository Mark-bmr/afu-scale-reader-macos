3. 编写最小实现

   ```swift
   public static let minimumAdvertisementQuietInterval: TimeInterval = 45
   self.advertisementQuietInterval = max(
       advertisementQuietInterval,
       Self.minimumAdvertisementQuietInterval
   )

   // D6 保存后直接 return，不调用 cancelPeripheralConnection。
   guard sessionMode.persistsHistoricalMeasurements else {
       log("Ignoring historical measurement result in live mode")
       return
   }
   ```

