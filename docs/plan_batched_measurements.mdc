   SWIFTPM_MODULECACHE_OVERRIDE=/tmp/afu-scale-swiftpm-cache \
   swift test --disable-sandbox --scratch-path /tmp/afu-scale-build

   CLANG_MODULE_CACHE_PATH=/tmp/afu-scale-clang-cache \
   SWIFTPM_MODULECACHE_OVERRIDE=/tmp/afu-scale-swiftpm-cache \
   swift build --disable-sandbox --scratch-path /tmp/afu-scale-release -c release

   bash scripts/check-public-repo.sh

   git add Sources/AFUCore/MeasurementDeduplicator.swift \
     Sources/AFUReader/BluetoothReader.swift \
     Tests/AFUCoreTests/MeasurementDeduplicatorTests.swift \
     docs/plan_batched_measurements.mdc
   git commit -m "fix: preserve measurement across reconnect"
