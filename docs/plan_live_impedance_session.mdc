   git add Sources/AFUCore/BluetoothLifecycle.swift Tests/AFUCoreTests/BluetoothLifecycleTests.swift Sources/AFUCore/ReaderConfiguration.swift Tests/AFUCoreTests/ReaderConfigurationTests.swift Sources/AFUReader/BluetoothReader.swift config.example.json
   git commit -m "fix: gate reconnects between scale wake cycles"
